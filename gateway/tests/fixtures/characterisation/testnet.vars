# Example policy environment for the characterisation tests (placeholder hosts,
# documentation addresses, fake keys).
NETWORK=testnet
GATEWAY_HOSTS=gateway-testnet.example
BACKENDS=prices.example=https://prices-api.example,near.example=https://near-api.example,vote.example=https://voting.example,voting.example=https://voting.example,service.example=https://service.example,files.example=https://files.example
BACKENDS_POLICY=gateway-testnet.example=POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/*;prices.example=GET /v1/cryptocurrency/quotes/latest,GET /v1/fiat/map,GET /v1/key/info;near.example=GET /v0/tokens,POST /v0/quote,GET /v0/status,POST /v0/deposit/submit;vote.example=GET /*,POST /*,PUT /*,DELETE /*,HEAD /*,OPTIONS /*;voting.example=GET /*,POST /*,PUT /*,DELETE /*,HEAD /*,OPTIONS /*;service.example=GET /v1/info,POST /v1/slots,GET /v1/slots/*,POST /v1/slots/*;files.example=GET /example-org/voting-config/*
BACKEND_HEADERS=prices.example=X-PRICES_API_KEY:fake-prices-api-key,near.example=Authorization:Bearer fake-near-jwt
NEAR_ALIAS=near.example
THIRD_PARTY_CACHE_ROUTES=prices.example=GET /v1/cryptocurrency/quotes/latest@120,GET /v1/fiat/map@21600;near.example=GET /v0/tokens@300
THIRD_PARTY_RATE_LIMITS=prices.example=10/60s,near.example=120/60s
THIRD_PARTY_QUERY_VALUE_SOURCES=fiat=prices.example GET /v1/fiat/map#/data/*/symbol@21600@fallback=AED|ALL|AMD|ARS|AUD|AZN|BAM|BDT|BGN|BHD|BMD|BOB|BRL|BYN|CAD|CHF|CLP|CNY|COP|CRC|CUP|CZK|DKK|DOP|DZD|EGP|EUR|GBP|GEL|GHS|GTQ|HKD|HNL|HRK|HUF|IDR|ILS|INR|IQD|IRR|ISK|JMD|JOD|JPY|KES|KGS|KHR|KRW|KWD|KZT|LBP|LKR|MAD|MDL|MKD|MMK|MNT|MUR|MXN|MYR|NAD|NGN|NIO|NOK|NPR|NZD|OMR|PAB|PEN|PHP|PKR|PLN|QAR|RON|RSD|RUB|SAR|SEK|SGD|SSP|THB|TND|TRY|TTD|TWD|UAH|UGX|USD|UYU|UZS|VES|VND|ZAR
THIRD_PARTY_QUERY_RULES=prices.example=GET /v1/cryptocurrency/quotes/latest?symbol=ZEC&convert={from:fiat},GET /v1/fiat/map?
THIRD_PARTY_HOSTS_PUBLISH=all
REPLAY_READ_ROUTES=lwd=POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetLatestBlock,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetBlock,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetBlockNullifiers,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetBlockRange,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetBlockRangeNullifiers,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetTransaction,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetTaddressTxids,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetTaddressBalance,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetTaddressBalanceStream,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetMempoolTx,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetMempoolStream,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetTreeState,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetLatestTreeState,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetSubtreeRoots,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetAddressUtxos,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetAddressUtxosStream,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/GetLightdInfo,POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/Ping;prices.example=GET /*;near.example=GET /v0/tokens,GET /v0/status;vote.example=GET /*;voting.example=GET /*;service.example=GET /v1/info,GET /v1/slots/*;flexa.example=GET /*
REPLAY_ONE_SIDED_WRITE_ROUTES=lwd=POST /cash.z.wallet.sdk.rpc.CompactTxStreamer/SendTransaction
DYNAMIC_HOST_SOURCES=[{"name":"voting","url":"https://voting.example/prod/dynamic-voting-config.json","lists":[{"pointer":"/hosts_a","url_field":"url","routes":"GET /*,POST /*,PUT /*,DELETE /*,HEAD /*,OPTIONS /*","read_routes":"GET /*"},{"pointer":"/hosts_b","url_field":"url","routes":"GET /a,GET /b,GET /c/d,POST /d/query","read_routes":"GET /a,GET /b,GET /c/d,POST /d/query"}],"max_hosts":40}]
DYNAMIC_HOSTS_DENY_CIDRS=192.0.2.0/28,2001:db8::/32
RELAY_SECRET_ON_KEY_CONFIG=require
MAX_BLOCK_RANGE=10000
MAX_INFLIGHT_LWD=32
MAX_INFLIGHT_LWD_HEAVY=4
LWD_HEAVY_BLOCK_RANGE=100
MAX_UPSTREAM_RESPONSE_BYTES=268435456
MAX_CACHE_GET_CONCURRENCY=64
MAX_LARGE_RESPONSE_CONCURRENCY=1
LWD_TIMEOUT_SECS=80
LWD_ADDR=lwd.example:9067
