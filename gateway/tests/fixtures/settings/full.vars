# Every setting of the gateway with a valid value other than its default (placeholder hosts,
# fake secrets), and a small policy: the settings equivalence tests (tests/config_settings.rs).
NETWORK=testnet
GATEWAY_HOSTS=gateway.example
BACKENDS=prices.example=https://prices-api.example
BACKENDS_POLICY=prices.example=GET /v1/quotes
BACKEND_HEADERS=prices.example=X-Api-Key:prices-key-fake-1
GATEWAY_MODE=ohttp
HEADER_READ_TIMEOUT_SECS=310
RUST_LOG=info,zodl_ohttp_gateway::proxy=debug
LOG_OUTER_HEADER_NAMES=1
ALLOW_UNAUTHENTICATED_RELAY=0
HPKE_KEY_ID=7
MAX_INFLIGHT_REQUESTS=900
MAX_UPSTREAM_RESPONSE_BYTES=33554432
MAX_INFLIGHT_UPSTREAM=200
MAX_INFLIGHT_PER_BACKEND=50
LWD_HEAVY_BLOCK_RANGE=120
LWD_PERMIT_WAIT_MS=1500
LWD_PERMIT_MAX_WAITERS=64
MAX_BLOCK_RANGE=12000
LWD_TIMEOUT_SECS=70
LWD_UNARY_TIMEOUT_SECS=9
LWD_SEND_TIMEOUT_SECS=60
LWD_STREAM_IDLE_SECS=19
LWD_CONNECT_TIMEOUT_MS=1800
LWD_HEDGE_DELAY_MS=400
LWD_HEDGE_MAX_INFLIGHT=8
LONG_POLL_MAX_INITIAL_SILENCE_SECS=20
LONG_POLL_IDLE_SECS=4
SSE_KEEPALIVE_SECS=15
MAX_CACHE_GET_CONCURRENCY=48
MAX_LARGE_RESPONSE_CONCURRENCY=2
LARGE_RESPONSE_THRESHOLD=4194304
HEALTHZ_LWD_ERROR_RATIO=0.25
HEALTHZ_LWD_ERROR_WINDOW_SECS=45
HEALTHZ_LWD_MIN_ERRORS=6
REDIS_OP_TIMEOUT_MS=300
CHUNK_SIZE=8192
CHUNK_FLUSH_MS=40
RESPONSE_PADDING=sensitive
REPLAY_FRESHNESS=enforce
REPLAY_FRESHNESS_WINDOW_SECS=240
REPLAY_WAIT_CONNS=6
REPLAY_FALLBACK_HEALTH_FAILURES=25
REPLAY_FALLBACK_HEALTH_WINDOW_SECS=90
REPLAY_STARTUP_STORES_WAIT_SECS=12
DYNAMIC_HOSTS_MAX_DOCUMENT_BYTES=131072
DYNAMIC_HOSTS_FETCH_TIMEOUT_SECS=8
LOCAL_CACHE_BYTES=134217728
LOCAL_CACHE_MAX_ENTRY_BYTES=32768
PERMANENT_MIN_HEIGHT=290000
PERMANENT_OP_TIMEOUT_MS=2500
CHAIN_TIP_STALE_SECS=160
PREFETCH_TIP=0
PREFETCH_BLOCK_TXS_MAX=90
PREFETCH_TREE_STATE=1
PINNED_TREESTATE_RANGE=1-
HPKE_KEYS=7:1111111111111111111111111111111111111111111111111111111111111111
HPKE_PRIVATE_KEY=2222222222222222222222222222222222222222222222222222222222222222
HPKE_ACCEPT_ONLY_KEYS=8:3333333333333333333333333333333333333333333333333333333333333333
RELAY_SECRETS=edge-a=relay-fake-secret-a,edge-b=relay-fake-secret-b
CONFIGS_SIGNING_SEED_HEX=4444444444444444444444444444444444444444444444444444444444444444
FLEXA_PUBLISHABLE_KEY=publishable-fake-key
PORT=8081
INTERNAL_BIND_ADDR=127.0.0.1:9091
ORIGIN_ID=origin-a
RELAY_WEIGHTS_FILE=/run/relay-weights/relay-weights.json
LWD_ADDR=lwd.example:9067
LWD_ENDPOINTS=lwd-endpoints.example:9067
LWD_CONNECTION_POOL=on
CACHE_KEY_BACKEND=lwd-cache.example:9067
MAX_INFLIGHT_LWD=96
MAX_INFLIGHT_LWD_HEAVY=20
PINNED_BACKFILL_WORKERS=2
PREFETCH_BLOCK_TXS=true
REDIS_URL=redis://:cache-fake-password@cache.example:6379
REDIS_SECURITY_URL=rediss://security.example:6380
REDIS_PINNED_URL=redis://:pinned-fake-password@pinned.example:6379
REDIS_PINNED_WRITE_URL=redis://pinned-primary.example:6379
PERMANENT_REDIS_URL=redis://permanent.example:6379
REPLAY_PEER_URLS=rediss://:peer-fake-password@peer-a.example:6380,rediss://peer-b.example:6380
REPLAY_STANDBY_URLS=rediss://standby.example:6380
REPLAY_PEER_MODE=async-reads
REPLAY_PEER_TIMEOUT_MS=200
REPLAY_PEER_FAIL_CLOSED=false
REPLAY_PEER_FAIL_CLOSED_WRITES=0
REPLAY_PEER_WAIT_REPLICAS=1
REPLAY_PEER_WAIT_MS=120
REPLAY_ASYNC_MAX_LAG_MS=600
REPLAY_ASYNC_RECOVERY_SECS=40
REPLAY_ASYNC_FAILURES_BEFORE_STRICT=4
REPLAY_WRITE_WAIT_REPLICAS=1
REPLAY_WRITE_WAIT_MS=90
REPLAY_UNAVAILABLE_FALLBACK=1
REPLAY_LOCAL_WAITAOF_MS=1500
REPLAY_WRITE_FORWARD_URL=http://hub.example:9443
REPLAY_WRITE_FORWARD_SECRET=forward-fake-secret-out
REPLAY_WRITE_FORWARD_CONNECT_TIMEOUT_MS=900
REPLAY_WRITE_FORWARD_TIMEOUT_SECS=85
REPLAY_WRITE_FORWARD_BACKOFF_MS=4000
WRITE_FORWARD_BIND_ADDR=127.0.0.1:9444
WRITE_FORWARD_SECRETS=origins=forward-fake-secret-in
